{
  "manifest_version": 3,
  "name": "ReproBug Error Capture",
  "version": "0.1.0",
  "description": "Capture browser JavaScript errors and send them to your ReproBug workspace.",
  "permissions": ["activeTab", "scripting", "storage", "notifications"],
  "optional_host_permissions": ["http://localhost:4000/*", "https://*/*", "http://*/*"],
  "background": { "service_worker": "service-worker.js", "type": "module" },
  "action": {
    "default_title": "Capture errors with ReproBug",
    "default_popup": "popup.html"
  }
}
